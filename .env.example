# Copy to .env to override defaults. All values are public and ship in the
# client bundle, so never put a secret in this file.

# Base URL of the Amtraker-compatible API. Point this at a self-hosted mirror or
# a caching proxy if you do not want the browser calling api.amtraker.com.
VITE_AMTRAKER_API_BASE=https://api.amtraker.com

# MapLibre style JSON URL. The default is CARTO dark-matter on OpenStreetMap data.
# Any MapLibre-compatible style works, subject to its provider's usage policy.
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
